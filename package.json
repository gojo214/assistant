{
  "name": "assistant",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "node --test tests/telegram-webhook.test.mjs",
    "webhook:set": "node --env-file-if-exists=.env scripts/set-webhook.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@hono/cli": "^1.0.0-rc.9",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
